#include "../ui/VelocityCopy.UI/Version.h"
#include <windows.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_SHELL_COPY_HERE "Copy here with VelocityCopy"
    IDS_SHELL_MOVE_HERE "Move here with VelocityCopy"
END
LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN
STRINGTABLE
BEGIN
    IDS_SHELL_COPY_HERE "Copiar aqui con VelocityCopy"
    IDS_SHELL_MOVE_HERE "Mover aqui con VelocityCopy"
END


LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VELOCITYCOPY_VERSION_COMMA
 PRODUCTVERSION VELOCITYCOPY_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ReinierTutoriales\0"
            VALUE "FileDescription", "VelocityCopy Explorer Shell Extension\0"
            VALUE "FileVersion", VELOCITYCOPY_VERSION_STRING "\0"
            VALUE "InternalName", "VelocityCopy.Shell.dll\0"
            VALUE "OriginalFilename", "VelocityCopy.Shell.dll\0"
            VALUE "ProductName", "VelocityCopy\0"
            VALUE "ProductVersion", VELOCITYCOPY_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
