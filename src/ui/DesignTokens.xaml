<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="WindowCompactWidth">380</x:Double>
    <x:Double x:Key="WindowNarrowWidth">360</x:Double>
    <x:Double x:Key="WindowComfortableBreakpoint">420</x:Double>
    <x:Double x:Key="WindowCollapsedHeight">72</x:Double>
    <x:Double x:Key="WindowExpandedHeight">300</x:Double>
    <x:Double x:Key="WindowMinWidth">360</x:Double>

    <x:Double x:Key="ContentGutter">8</x:Double>
    <x:Double x:Key="SectionSpacing">8</x:Double>
    <x:Double x:Key="ControlSpacing">8</x:Double>
