<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightCompact}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="420" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightComfortable}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TransferSurface"
              Grid.Row="0"
              Height="72"
              SizeChanged="OnTransferSurfaceSizeChanged">
            <Grid>
                <Border x:Name="ProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.12" />

                <Grid x:Name="TitleBarDragRegion"
                      Height="34"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      IsHitTestVisible="True" />

                <Grid x:Name="TransferContentGrid"
                      Padding="{StaticResource TransferContentPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CaptionContentGrid"
                          Grid.Row="0"
                          Padding="{StaticResource CaptionContentPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="BrandLogo"
                               Grid.Column="0"
                               Source="Assets/VelocityCopy.png"
                               Width="20"
                               Height="20"
                               Margin="{StaticResource BrandToContentMargin}"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               IsHitTestVisible="False" />

                        <TextBlock x:Name="CurrentItemText"
                                   Grid.Column="1"
                                   x:Uid="CurrentItemText"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </Grid>

                    <Grid x:Name="BottomContentGrid"
                          Grid.Row="1">
                        <StackPanel x:Name="TelemetryStrip"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:Name="SpeedText" Text="—" Opacity="0.62" FontSize="10.5" />
                            <TextBlock x:Name="ProgressPercentText" Text="0%" Opacity="0.82" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="EtaText" Text="—" Opacity="0.62" FontSize="10.5" />
                        </StackPanel>

                        <StackPanel x:Name="PrimaryActionCluster"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <Button x:Name="PauseButton"
                                    Click="OnPauseClick"
                                    IsEnabled="False"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="PauseIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE769;"
                                          FontSize="12" />
                            </Button>

                            <Button x:Name="CancelButton"
                                    Click="OnCancelClick"
                                    IsEnabled="False"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="CancelIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE711;"
                                          FontSize="11.5" />
                            </Button>

                            <Button x:Name="OptionsButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="OptionsIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE712;"
                                          FontSize="12" />
                            </Button>

                            <Button x:Name="QueueButton"
                                    Click="OnQueueClick"
                                    IsEnabled="True"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="QueueChevron"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Skip and Stop keep generated accessors for execution-state code,
                         but remain non-visual; their commands live in Options. -->
                    <Button x:Name="SkipButton"
                            Grid.Row="1"
                            Click="OnSkipClick"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Width="0"
                            Height="0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <FontIcon x:Name="SkipIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" FontSize="12" />
                    </Button>
                    <Button x:Name="StopButton"
                            Grid.Row="1"
                            Click="OnStopClick"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Width="0"
                            Height="0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <FontIcon x:Name="StopIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="11.5" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="QueuePanel"
              Grid.Row="1"
              Visibility="Collapsed"
              Padding="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="QueueHeader" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueTitle"
                           x:Uid="QueueTitle"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <TextBlock x:Name="QueueCountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.58"
                           FontSize="11" />
            </Grid>

            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      Margin="0,4,0,0"
                      MaxHeight="{StaticResource QueueMaxHeightCompact}"
                      SelectionMode="Extended"
                      SelectionChanged="OnQueueSelectionChanged"
                      KeyDown="OnQueueKeyDown"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnQueueDragItemsCompleted"
                      HorizontalContentAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="QueueMoveUpButton"
                        Click="OnQueueMoveUpClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button x:Name="QueueMoveDownButton"
                        Grid.Column="1"
                        Click="OnQueueMoveDownClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button x:Name="QueueRemoveButton"
                        Grid.Column="2"
                        Click="OnQueueRemoveClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.RowSpan="2"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 VerticalAlignment="Top"
                 Margin="0,32,0,0" />
    </Grid>
</Window>
