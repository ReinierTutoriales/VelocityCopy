<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragLeave="OnDragLeave"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TransferSurface"
              Grid.Row="0">
            <Grid>
                <ProgressBar x:Name="TransferProgress"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Stretch"
                             IsHitTestVisible="False" />

                <Grid x:Name="TitleBarDragRegion"
                      Height="{StaticResource CaptionRowHeight}"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      IsHitTestVisible="True" />

                <Grid x:Name="TransferContentGrid"
                      Padding="{StaticResource TransferContentPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="CaptionRowDefinition" Height="{StaticResource CaptionRowGridLength}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CaptionContentGrid"
                          Grid.Row="0"
                          Padding="{StaticResource CaptionContentPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="BrandLogo"
                               Grid.Column="0"
                               Source="Assets/VelocityCopy.png"
                               Width="{StaticResource BrandMarkSize}"
                               Height="{StaticResource BrandMarkSize}"
                               Margin="{StaticResource BrandToContentMargin}"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               IsHitTestVisible="False" />

                        <TextBlock x:Name="CurrentItemText"
                                   Grid.Column="1"
                                   x:Uid="CurrentItemText"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource BodyFontSize}" />
                    </Grid>

                    <Grid x:Name="TransferDetailGrid"
                          Grid.Row="1"
                          Margin="{StaticResource TransferDetailMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TransferBytesText"
                                   FontSize="{StaticResource BodyFontSize}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock x:Name="TransferFilesText"
                                   Grid.Row="1"
                                   Margin="{StaticResource TransferFilesMargin}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </Grid>

                    <Grid x:Name="TransferPathGrid"
                          Grid.Row="2"
                          Margin="{StaticResource TransferPathMargin}"
                          ColumnSpacing="{StaticResource SpaceRelated}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourcePathText"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <FontIcon Grid.Column="1"
                                  Glyph="&#xE72A;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="{StaticResource PathArrowIconSize}"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  IsHitTestVisible="False" />
                        <TextBlock x:Name="DestinationPathText"
                                   Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </Grid>

                    <Grid x:Name="BottomContentGrid"
                          Grid.Row="3"
                          Margin="{StaticResource TransferBottomMargin}"
                          ColumnSpacing="{StaticResource SpaceRelated}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="TelemetryStrip"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource SpaceTight}">
                            <TextBlock x:Name="SpeedText"
                                       Text="—"
                                       MinWidth="{StaticResource TelemetrySpeedMinWidth}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}" />
                            <TextBlock x:Name="ProgressPercentText"
                                       Text="0%"
                                       MinWidth="{StaticResource TelemetryPercentMinWidth}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="EtaText"
                                       Text="—"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}" />
                        </StackPanel>

                        <StackPanel x:Name="PrimaryActionCluster"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource SpaceTight}">
                            <Grid x:Name="PauseButtonHost"
                                  Width="{StaticResource ActionButtonSize}"
                                  Height="{StaticResource ActionButtonSize}"
                                  Background="Transparent">
                                <Button x:Name="PauseButton"
                                        Click="OnPauseClick"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <FontIcon x:Name="PauseIcon"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE769;"
                                              FontSize="{StaticResource ActionIconSize}" />
                                </Button>
                            </Grid>

                            <Grid x:Name="CancelButtonHost"
                                  Width="{StaticResource ActionButtonSize}"
                                  Height="{StaticResource ActionButtonSize}"
                                  Background="Transparent">
                                <Button x:Name="CancelButton"
                                        Click="OnCancelClick"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <FontIcon x:Name="CancelIcon"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE71A;"
                                              FontSize="{StaticResource ActionIconSize}" />
                                </Button>
                            </Grid>

                            <Button x:Name="OptionsButton"
                                    Width="{StaticResource ActionButtonSize}"
                                    Height="{StaticResource ActionButtonSize}"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="OptionsIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE712;"
                                          FontSize="{StaticResource ActionIconSize}" />
                            </Button>

                            <Button x:Name="DetailsButton"
                                    Click="OnDetailsClick"
                                    Width="{StaticResource ActionButtonSize}"
                                    Height="{StaticResource ActionButtonSize}"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE946;"
                                          FontSize="{StaticResource ActionIconSize}" />
                            </Button>

                            <Button x:Name="QueueButton"
                                    Click="OnQueueClick"
                                    IsEnabled="True"
                                    Width="{StaticResource ActionButtonSize}"
                                    Height="{StaticResource ActionButtonSize}"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <FontIcon x:Name="QueueChevron"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="{StaticResource ActionIconSize}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.Row="1"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />

        <Grid x:Name="DetailsPanel"
              Grid.Row="2"
              Visibility="Collapsed"
              Padding="{StaticResource DetailsPanelPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DetailsInformationTitle"
                       x:Uid="DetailsInformationTitle"
                       FontWeight="SemiBold"
                       FontSize="{StaticResource BodyFontSize}" />

            <Grid Grid.Row="1"
                  Margin="{StaticResource DetailsSectionMargin}"
                  ColumnSpacing="{StaticResource SpaceRelated}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="DetailsSourceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsSourceText" Grid.Column="1" TextWrapping="Wrap" MaxLines="2" FontSize="{StaticResource CaptionFontSize}" />

                <TextBlock x:Uid="DetailsDestinationLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsDestinationText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" MaxLines="2" FontSize="{StaticResource CaptionFontSize}" />

                <TextBlock x:Uid="DetailsBytesLabel" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsBytesText" Grid.Row="2" Grid.Column="1" FontSize="{StaticResource CaptionFontSize}" />

                <TextBlock x:Uid="DetailsFilesLabel" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsFilesText" Grid.Row="3" Grid.Column="1" FontSize="{StaticResource CaptionFontSize}" />

                <TextBlock x:Uid="DetailsSpeedLabel" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsSpeedText" Grid.Row="4" Grid.Column="1" FontSize="{StaticResource CaptionFontSize}" />

                <TextBlock x:Uid="DetailsEtaLabel" Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                <TextBlock x:Name="DetailsEtaText" Grid.Row="5" Grid.Column="1" FontSize="{StaticResource CaptionFontSize}" />
            </Grid>

            <Grid Grid.Row="2" Margin="{StaticResource DetailsPerformanceMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailsPerformanceTitle"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource BodyFontSize}" />
                    <TextBlock x:Name="PerformanceCurrentSpeedText"
                               Grid.Column="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="{StaticResource CaptionFontSize}" />
                </Grid>
                <Border x:Name="PerformanceGraphBrushSource"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />
                <Border Grid.Row="1"
                        Margin="{StaticResource PerformanceGraphMargin}"
                        Height="{StaticResource PerformanceGraphHeight}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Canvas x:Name="PerformanceGraph" AutomationProperties.AccessibilityView="Raw" />
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="QueuePanel"
              Grid.Row="3"
              Visibility="Collapsed"
              Padding="{StaticResource QueuePanelPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="QueueHeader" MinHeight="{StaticResource QueueHeaderMinHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueTitle"
                           x:Uid="QueueTitle"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource BodyFontSize}" />
                <TextBlock x:Name="QueueCountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="{StaticResource CaptionFontSize}" />
            </Grid>

            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      Margin="{StaticResource QueueListMargin}"
                      SelectionMode="Extended"
                      SelectionChanged="OnQueueSelectionChanged"
                      KeyDown="OnQueueKeyDown"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnQueueDragItemsCompleted"
                      HorizontalContentAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="{StaticResource QueueCommandsMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="QueueMoveUpButtonHost"
                      Width="{StaticResource ActionButtonSize}"
                      Height="{StaticResource ActionButtonSize}"
                      Margin="{StaticResource QueueCommandGapMargin}"
                      Background="Transparent">
                    <Button x:Name="QueueMoveUpButton"
                            Click="OnQueueMoveUpClick"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" FontSize="{StaticResource ActionIconSize}" />
                    </Button>
                </Grid>
                <Grid x:Name="QueueMoveDownButtonHost"
                      Grid.Column="1"
                      Width="{StaticResource ActionButtonSize}"
                      Height="{StaticResource ActionButtonSize}"
                      Margin="{StaticResource QueueCommandGapMargin}"
                      Background="Transparent">
                    <Button x:Name="QueueMoveDownButton"
                            Click="OnQueueMoveDownClick"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="{StaticResource ActionIconSize}" />
                    </Button>
                </Grid>
                <Grid x:Name="QueueRemoveButtonHost"
                      Grid.Column="2"
                      Width="{StaticResource ActionButtonSize}"
                      Height="{StaticResource ActionButtonSize}"
                      Background="Transparent">
                    <Button x:Name="QueueRemoveButton"
                            Click="OnQueueRemoveClick"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="{StaticResource ActionIconSize}" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
