<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightCompact}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="520" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightComfortable}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TransferSurface"
              Grid.Row="0"
              Height="72"
              SizeChanged="OnTransferSurfaceSizeChanged">
            <Grid>
                <Border x:Name="ProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.12" />

                <Grid x:Name="TitleBarDragRegion"
                      Height="32"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      IsHitTestVisible="True" />

                <Grid Padding="14,9,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                        <Image x:Name="BrandLogo"
                               Source="Assets/VelocityCopy.png"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"
                               IsHitTestVisible="False" />
                    </Grid>

                    <Grid Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CurrentItemText"
                                   x:Uid="CurrentItemText"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,2,0,0">
                            <TextBlock x:Name="SpeedText" Text="—" Opacity="0.62" FontSize="11" />
                            <TextBlock x:Name="ProgressPercentText" Text="0%" Opacity="0.82" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="EtaText" Text="—" Opacity="0.62" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="PauseButton"
                            Grid.Column="2"
                            Click="OnPauseClick"
                            IsEnabled="False"
                            Width="28"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="10,0,3,0">
                        <FontIcon x:Name="PauseIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE769;"
                                  FontSize="13" />
                    </Button>

                    <Button x:Name="SkipButton"
                            Grid.Column="3"
                            Click="OnSkipClick"
                            IsEnabled="False"
                            Width="28"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,3,0">
                        <FontIcon x:Name="SkipIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE893;"
                                  FontSize="13" />
                    </Button>

                    <Button x:Name="StopButton"
                            Grid.Column="4"
                            Click="OnStopClick"
                            IsEnabled="False"
                            Width="28"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,3,0">
                        <FontIcon x:Name="StopIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE71A;"
                                  FontSize="12" />
                    </Button>

                    <Button x:Name="CancelButton"
                            Grid.Column="5"
                            Click="OnCancelClick"
                            IsEnabled="False"
                            Width="28"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,3,0">
                        <FontIcon x:Name="CancelIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE711;"
                                  FontSize="12" />
                    </Button>

                    <Button x:Name="OptionsButton"
                            Grid.Column="6"
                            Width="28"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="1,0,6,0">
                        <FontIcon x:Name="OptionsIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE713;"
                                  FontSize="13" />
                    </Button>

                    <Button x:Name="QueueButton"
                            Grid.Column="7"
                            Click="OnQueueClick"
                            IsEnabled="False"
                            Width="30"
                            Height="28"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <FontIcon x:Name="QueueChevron"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE70D;"
                                  FontSize="12" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="QueuePanel"
              Grid.Row="1"
              Visibility="Collapsed"
              Padding="14,8,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="QueueHeader" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueTitle"
                           x:Uid="QueueTitle"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <TextBlock x:Name="QueueCountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.58"
                           FontSize="11" />
            </Grid>

            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      Margin="0,4,0,0"
                      MaxHeight="{StaticResource QueueMaxHeightCompact}"
                      SelectionMode="Extended"
                      SelectionChanged="OnQueueSelectionChanged"
                      KeyDown="OnQueueKeyDown"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnQueueDragItemsCompleted"
                      HorizontalContentAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="QueueMoveUpButton"
                        Click="OnQueueMoveUpClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button x:Name="QueueMoveDownButton"
                        Grid.Column="1"
                        Click="OnQueueMoveDownClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button x:Name="QueueRemoveButton"
                        Grid.Column="2"
                        Click="OnQueueRemoveClick"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.RowSpan="2"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 VerticalAlignment="Top"
                 Margin="0,32,0,0" />
    </Grid>
</Window>
