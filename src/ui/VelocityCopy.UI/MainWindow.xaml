<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VelocityCopyUI">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Background="Transparent">
        <Grid.Resources>
            <DataTemplate x:Key="QueueItemTemplate" x:DataType="local:QueueItem">
                <Grid Margin="{StaticResource QueueItemMargin}" HorizontalAlignment="Stretch" RowSpacing="{StaticResource QueueItemLineSpacing}"
                      ToolTipService.ToolTip="{x:Bind FullPath}" AutomationProperties.Name="{x:Bind FullPath}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource QueueItemIconSize}"
                                  Style="{StaticResource SecondaryIconStyle}" Margin="{StaticResource QueueItemIconMargin}"
                                  VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="QueueNarrowItemTemplate" x:DataType="local:QueueItem">
                <Grid Margin="{StaticResource QueueNarrowItemMargin}" HorizontalAlignment="Stretch"
                      ToolTipService.ToolTip="{x:Bind FullPath}" AutomationProperties.Name="{x:Bind FullPath}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource QueueItemIconSize}"
                                  Style="{StaticResource SecondaryIconStyle}" Margin="{StaticResource QueueItemIconMargin}"
                                  VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
                    </Grid>
                    <TextBlock Grid.Column="1" MaxWidth="{StaticResource QueueNarrowLocationMaxWidth}" Margin="8,0,0,0" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource CaptionFontSize}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TransferSurface" Grid.Row="0">
            <Grid>
                <Grid x:Name="TitleBarDragRegion"
                      Height="{StaticResource CaptionRowHeight}"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      IsHitTestVisible="True" />

                <Grid x:Name="TransferContentGrid" Padding="{StaticResource TransferContentPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="CaptionRowDefinition" Height="{StaticResource CaptionRowGridLength}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CaptionContentGrid" Grid.Row="0" Padding="{StaticResource CaptionContentPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="BrandLogo"
                               Grid.Column="0"
                               Source="Assets/VelocityCopy.png"
                               Width="{StaticResource BrandMarkSize}"
                               Height="{StaticResource BrandMarkSize}"
                               Margin="{StaticResource BrandToContentMargin}"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               IsHitTestVisible="False" />

                        <TextBlock x:Name="CurrentItemText"
                                   Grid.Column="1"
                                   x:Uid="CurrentItemText"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource BodyFontSize}" />
                    </Grid>

                    <Grid x:Name="TransferDetailGrid" Grid.Row="1" Margin="{StaticResource TransferDetailMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="CurrentItemIcon"
                                  Glyph="&#xE8A5;"
                                  FontSize="{StaticResource TransferItemIconSize}"
                                  Style="{StaticResource AccentIconStyle}"
                                  Margin="{StaticResource TransferItemIconMargin}"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="TransferBytesText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource BodyFontSize}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock x:Name="TransferFilesText"
                                   Grid.Column="2"
                                   Margin="{StaticResource TransferFilesMargin}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </Grid>

                    <ProgressBar x:Name="TransferProgress"
                                 Grid.Row="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 MinHeight="{StaticResource TransferProgressHeight}"
                                 Margin="{StaticResource TransferProgressMargin}"
                                 HorizontalAlignment="Stretch"
                                 IsHitTestVisible="False">
                        <ProgressBar.Resources>
                            <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
                        </ProgressBar.Resources>
                    </ProgressBar>

                    <Grid x:Name="TransferPathGrid"
                          Grid.Row="3"
                          Margin="{StaticResource TransferPathMargin}"
                          ColumnSpacing="{StaticResource SpaceRelated}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourcePathText"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <FontIcon Grid.Column="1"
                                  Glyph="&#xE72A;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="{StaticResource PathArrowIconSize}"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  IsHitTestVisible="False"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="DestinationPathText"
                                   Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </Grid>

                    <Grid x:Name="BottomContentGrid"
                          Grid.Row="4"
                          Margin="{StaticResource TransferBottomMargin}"
                          ColumnSpacing="{StaticResource SpaceRelated}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="TelemetryStrip"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource SpaceTight}">
                            <TextBlock x:Name="SpeedText"
                                       Text="—"
                                       MinWidth="{StaticResource TelemetrySpeedMinWidth}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}" />
                            <TextBlock x:Name="ProgressPercentText"
                                       Text="0%"
                                       MinWidth="{StaticResource TelemetryPercentMinWidth}"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="EtaText"
                                       Text="—"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}" />
                        </StackPanel>

                        <StackPanel x:Name="PrimaryActionCluster"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource SpaceTight}">
                            <Grid x:Name="PauseButtonHost"
                                  Width="{StaticResource ActionButtonSize}"
                                  Height="{StaticResource ActionButtonSize}"
                                  Background="Transparent">
                                <Button x:Name="PauseButton"
                                        Click="OnPauseClick"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="AccentFillColorDefaultBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="AccentFillColorDefaultBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast" />
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <FontIcon x:Name="PauseIcon"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE769;"
                                              FontSize="{StaticResource ActionIconSize}" />
                                </Button>
                            </Grid>

                            <Grid x:Name="SkipButtonHost"
                                  Width="{StaticResource ActionButtonSize}"
                                  Height="{StaticResource ActionButtonSize}"
                                  Background="Transparent">
                                <Button x:Name="SkipButton"
                                        Click="OnSkipClick"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast" />
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <FontIcon x:Name="SkipIcon"
                                              Glyph="&#xE893;"
                                              FontSize="{StaticResource ActionIconSize}" />
                                </Button>
                            </Grid>

                            <Grid x:Name="CancelButtonHost"
                                  Width="{StaticResource ActionButtonSize}"
                                  Height="{StaticResource ActionButtonSize}"
                                  Background="Transparent">
                                <Button x:Name="CancelButton"
                                        Click="OnCancelClick"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast" />
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <FontIcon x:Name="CancelIcon"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE71A;"
                                              FontSize="{StaticResource ActionIconSize}" />
                                </Button>
                            </Grid>

                            <Button x:Name="OptionsButton"
                                    Width="{StaticResource ActionButtonSize}"
                                    Height="{StaticResource ActionButtonSize}"
                                    Padding="0">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Default">
                                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast" />
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <FontIcon x:Name="OptionsIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE712;"
                                          FontSize="{StaticResource ActionIconSize}" />
                            </Button>
                        </StackPanel>

                        <Button x:Name="DetailsButton"
                                Grid.Column="3"
                                Click="OnDetailsClick"
                                Height="{StaticResource ActionButtonSize}"
                                HorizontalAlignment="Right">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast" />
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceRelated}">
                                <TextBlock x:Name="DetailsButtonText"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource BodyFontSize}" />
                                <FontIcon x:Name="DetailsChevronIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="{StaticResource ActionIconSize}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.Row="1"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />

        <ScrollViewer x:Name="ExpandedViewport"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid x:Name="ExpandedRegion"
                  Visibility="Collapsed"
                  Padding="{StaticResource DetailsPanelPadding}"
                  ColumnSpacing="{StaticResource ExpandedColumnSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ExpandedRow0" Height="Auto" />
                    <RowDefinition x:Name="ExpandedRow1" Height="0" />
                    <RowDefinition x:Name="ExpandedRow2" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExpandedColumn0" Width="*" />
                    <ColumnDefinition x:Name="ExpandedColumn1" Width="*" />
                    <ColumnDefinition x:Name="ExpandedColumn2" Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="QueuePanel" Grid.Row="0" Grid.Column="0" Margin="{StaticResource ExpandedSectionMargin}">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="{StaticResource ExpandedSectionPadding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="{StaticResource SectionHeaderPadding}">
                                <Grid x:Name="QueueHeader" MinHeight="{StaticResource QueueHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <FontIcon x:Name="QueueSectionIcon"
                                                  Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource SectionIconSize}"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="QueueTitle"
                                                   x:Uid="QueueTitle"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource BodyFontSize}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="{StaticResource QueueCountBadgeMargin}"
                                            Padding="{StaticResource QueueCountBadgePadding}"
                                            VerticalAlignment="Center"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock x:Name="QueueCountText"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="{StaticResource CaptionFontSize}" />
                                    </Border>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="QueueMoveUpButtonHost"
                                              Width="{StaticResource QueueCommandSize}"
                                              Height="{StaticResource QueueCommandSize}"
                                              Margin="{StaticResource QueueCommandGapMargin}"
                                              Background="Transparent">
                                            <Button x:Name="QueueMoveUpButton"
                                                    Click="OnQueueMoveUpClick"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="0">
                                            <Button.Resources>
                                                <ResourceDictionary>
                                                    <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                                    <ResourceDictionary.ThemeDictionaries>
                                                        <ResourceDictionary x:Key="Default">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="Light">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="HighContrast" />
                                                    </ResourceDictionary.ThemeDictionaries>
                                                </ResourceDictionary>
                                            </Button.Resources>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE96D;" FontSize="{StaticResource QueueCommandIconSize}" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="QueueMoveDownButtonHost"
                                              Grid.Column="1"
                                              Width="{StaticResource QueueCommandSize}"
                                              Height="{StaticResource QueueCommandSize}"
                                              Margin="{StaticResource QueueCommandGapMargin}"
                                              Background="Transparent">
                                            <Button x:Name="QueueMoveDownButton"
                                                    Click="OnQueueMoveDownClick"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="0">
                                            <Button.Resources>
                                                <ResourceDictionary>
                                                    <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                                    <ResourceDictionary.ThemeDictionaries>
                                                        <ResourceDictionary x:Key="Default">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="Light">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="HighContrast" />
                                                    </ResourceDictionary.ThemeDictionaries>
                                                </ResourceDictionary>
                                            </Button.Resources>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE96E;" FontSize="{StaticResource QueueCommandIconSize}" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="QueueRemoveButtonHost"
                                              Grid.Column="2"
                                              Width="{StaticResource QueueCommandSize}"
                                              Height="{StaticResource QueueCommandSize}"
                                              Background="Transparent">
                                            <Button x:Name="QueueRemoveButton"
                                                    Click="OnQueueRemoveClick"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="0">
                                            <Button.Resources>
                                                <ResourceDictionary>
                                                    <!-- Theme-keyed so the overrides follow light/dark changes; High Contrast keeps the system button. -->
                                                    <ResourceDictionary.ThemeDictionaries>
                                                        <ResourceDictionary x:Key="Default">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="Light">
                                                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="HighContrast" />
                                                    </ResourceDictionary.ThemeDictionaries>
                                                </ResourceDictionary>
                                            </Button.Resources>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="{StaticResource QueueCommandIconSize}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <ListView x:Name="QueueList"
                                      ItemTemplate="{StaticResource QueueItemTemplate}"
                                      Grid.Row="1"
                                      Margin="{StaticResource QueueListMargin}"
                                      SelectionMode="Extended"
                                      SelectionChanged="OnQueueSelectionChanged"
                                      KeyDown="OnQueueKeyDown"
                                      IsItemClickEnabled="False"
                                      IsSwipeEnabled="True"
                                      CanDragItems="True"
                                      CanReorderItems="True"
                                      AllowDrop="True"
                                      DragItemsStarting="OnQueueDragItemsStarting"
                                      DragItemsCompleted="OnQueueDragItemsCompleted"
                                      HorizontalContentAlignment="Stretch">
                                <!-- Not the list's ItemContainerStyle: RefreshQueue() applies this compact style only in
                                     Narrow mode. ThreeColumn keeps the native ListViewItem container. -->
                                <ListView.Resources>
                                    <Style x:Key="QueueNarrowListViewItemStyle"
                                           TargetType="ListViewItem"
                                           BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="MinHeight" Value="{StaticResource QueueNarrowItemContainerMinHeight}" />
                                        <Setter Property="Padding" Value="{StaticResource QueueNarrowItemContainerPadding}" />
                                    </Style>
                                </ListView.Resources>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="DetailsViewport" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid x:Name="DetailsGrid">
                        <Grid x:Name="InformationPanel" Margin="{StaticResource ExpandedSectionMargin}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="{StaticResource ExpandedSectionPadding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{StaticResource SectionHeaderPadding}">
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PerformanceCurrentSpeedText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource CaptionFontSize}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="{StaticResource SectionIconSize}"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      Margin="{StaticResource SectionIconMargin}"
                                                      IsHitTestVisible="False"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock x:Name="DetailsInformationTitle"
                                                       x:Uid="DetailsInformationTitle"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource BodyFontSize}" />
                                        </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1"
                                          Margin="{StaticResource DetailsSectionMargin}"
                                          ColumnSpacing="{StaticResource SpaceRelated}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <FontIcon Grid.Row="0" Glyph="&#xE8B7;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsSourceLabel" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsSourceText" Grid.Column="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="{StaticResource CaptionFontSize}" />

                                        <FontIcon Grid.Row="1" Glyph="&#xE8B7;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsDestinationLabel" Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsDestinationText" Grid.Row="1" Grid.Column="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="{StaticResource CaptionFontSize}" />

                                        <FontIcon Grid.Row="2" Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsBytesLabel" Grid.Row="2" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsBytesText" Grid.Row="2" Grid.Column="2" FontSize="{StaticResource CaptionFontSize}" />

                                        <FontIcon Grid.Row="3" Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsFilesLabel" Grid.Row="3" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsFilesText" Grid.Row="3" Grid.Column="2" FontSize="{StaticResource CaptionFontSize}" />

                                        <FontIcon Grid.Row="4" Glyph="&#xE9D2;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsSpeedLabel" Grid.Row="4" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsSpeedText" Grid.Row="4" Grid.Column="2" FontWeight="SemiBold" FontSize="{StaticResource CaptionFontSize}" />

                                        <FontIcon Grid.Row="5" Glyph="&#xE823;"
                                                  FontSize="{StaticResource InformationIconSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="{StaticResource SectionIconMargin}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="DetailsEtaLabel" Grid.Row="5" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <TextBlock x:Name="DetailsEtaText" Grid.Row="5" Grid.Column="2" FontSize="{StaticResource CaptionFontSize}" />
                                    </Grid>
                                    <Grid Grid.Row="2"
                                          Margin="{StaticResource PerformanceGraphMargin}"
                                          Height="{StaticResource PerformanceGraphHeight}"
                                          AutomationProperties.AccessibilityView="Raw">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="PerformanceScaleColumn" Width="Auto" MinWidth="{StaticResource PerformanceAxisLabelMinWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="PerformanceScaleLabels" Margin="0,0,8,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="PerformanceScaleMaxText"
                                                       AutomationProperties.AccessibilityView="Raw"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock x:Name="PerformanceScaleMidText"
                                                       AutomationProperties.AccessibilityView="Raw"
                                                       Grid.Row="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock x:Name="PerformanceScaleZeroText"
                                                       AutomationProperties.AccessibilityView="Raw"
                                                       Grid.Row="2"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                        <Border Grid.Column="1"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <Grid>
                                                <Border x:Name="PerformanceGraphMidline"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Opacity="0.55"
                                                        IsHitTestVisible="False"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                <Canvas x:Name="PerformanceGraph">
                                                    <Polygon x:Name="PerformanceGraphArea"
                                                             AutomationProperties.AccessibilityView="Raw"
                                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                             Opacity="0.16" />
                                                    <Polyline x:Name="PerformanceGraphLine"
                                                              AutomationProperties.AccessibilityView="Raw"
                                                              Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
