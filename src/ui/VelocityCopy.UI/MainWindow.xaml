<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Padding="{StaticResource ContentGutterThickness}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource ContentGutterCompactThickness}" />
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightCompact}" />
                        <Setter Target="DropFlowContent.Width" Value="{StaticResource DropFlyoutWidthCompact}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="520" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource ContentGutterThickness}" />
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightComfortable}" />
                        <Setter Target="DropFlowContent.Width" Value="{StaticResource DropFlyoutWidthComfortable}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="8" />

        <Border x:Name="TransferSurface"
                Grid.Row="1"
                Height="46"
                CornerRadius="23"
                SizeChanged="OnTransferSurfaceSizeChanged"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Border x:Name="ProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.16"
                        CornerRadius="23" />

                <ProgressBar x:Name="GlobalProgress"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed" />

                <Grid Padding="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="0,0,6,0"
                            Margin="0,0,8,0">
                        <Button x:Name="QueueButton"
                                Click="OnQueueClick"
                                IsEnabled="False"
                                Content="▸"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Width="26"
                                Height="30"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent" />
                    </Border>

                    <Grid Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CurrentItemText"
                                   x:Uid="CurrentItemText"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,1,0,0">
                            <TextBlock x:Name="SpeedText" Text="—" Opacity="0.66" FontSize="11" />
                            <TextBlock x:Name="ProgressPercentText" Text="0%" Opacity="0.78" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="EtaText" Text="—" Opacity="0.66" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="PauseButton"
                            Grid.Column="2"
                            Click="OnPauseClick"
                            IsEnabled="False"
                            Width="30"
                            Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="8,0,2,0">
                        <FontIcon x:Name="PauseIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE769;"
                                  FontSize="14" />
                    </Button>
                    <Button x:Name="SkipButton"
                            Grid.Column="3"
                            Click="OnSkipClick"
                            IsEnabled="False"
                            Width="30"
                            Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,2,0">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE893;"
                                  FontSize="14" />
                    </Button>
                    <Button x:Name="StopButton"
                            Grid.Column="4"
                            Click="OnStopClick"
                            IsEnabled="False"
                            Width="30"
                            Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,2,0">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE71A;"
                                  FontSize="13" />
                    </Button>
                    <Button x:Name="CancelButton"
                            Grid.Column="5"
                            Click="OnCancelClick"
                            IsEnabled="False"
                            Width="30"
                            Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE711;"
                                  FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="QueuePanel"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="QueueHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueTitle"
                           x:Uid="QueueTitle"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="QueueCountText"
                           Grid.Column="1"
                           Opacity="0.65" />
            </Grid>

            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      Margin="0,6,0,0"
                      MaxHeight="{StaticResource QueueMaxHeightCompact}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnQueueDragItemsCompleted"
                      HorizontalContentAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="QueueMoveUpButton"
                        Click="OnQueueMoveUpClick"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="13" />
                </Button>
                <Button x:Name="QueueMoveDownButton"
                        Grid.Column="1"
                        Click="OnQueueMoveDownClick"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="13" />
                </Button>
                <Button x:Name="QueueRemoveButton"
                        Grid.Column="2"
                        Click="OnQueueRemoveClick"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="13" />
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.RowSpan="3"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 VerticalAlignment="Top"
                 Margin="0,32,0,0" />

        <Border x:Name="DragOverlay"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.12"
                CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock x:Uid="DropOverlayText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Button x:Name="FlyoutAnchor" Visibility="Collapsed">
            <Button.Flyout>
                <Flyout x:Name="DropFlowFlyout" Placement="Bottom">
                    <Grid x:Name="DropFlowContent" Width="{StaticResource DropFlyoutWidthCompact}" MinHeight="176">
                        <Grid x:Name="DestinationStep">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="DestinationTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid x:Name="DestinationBrowserHeader"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DestinationBackButton"
                                        x:Uid="DestinationBackButton"
                                        Click="OnDestinationBackClick"
                                        Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DestinationPathText"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DestinationCapacityText"
                                               Opacity="0.65"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DestinationItems" Spacing="4" />
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowseButton"
                                        x:Uid="BrowseButton"
                                        Click="OnBrowseClick" />
                                <Button x:Name="ChooseCurrentFolderButton"
                                        x:Uid="ChooseCurrentFolderButton"
                                        Grid.Column="2"
                                        Visibility="Collapsed"
                                        Click="OnChooseCurrentFolderClick"
                                        Margin="0,0,6,0" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="LayoutStep" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="LayoutTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock x:Name="SelectedDestinationText" Grid.Row="1" TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,0,0,8" />

                            <StackPanel Grid.Row="2" Spacing="6">
                                <ToggleButton x:Name="PreserveToggle"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Click="OnPreserveClick">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Uid="PreserveTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreservePreview" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="DirectToggle"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Click="OnDirectClick">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Uid="DirectTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DirectPreview" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackButton" x:Uid="BackButton" Click="OnBackClick" />
                                <Button x:Name="StartCopyButton" x:Uid="StartCopyButton" Grid.Column="2" Click="OnQueueOrStartCopyClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Window>