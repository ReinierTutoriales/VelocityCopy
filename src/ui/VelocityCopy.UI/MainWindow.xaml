<Window
    x:Class="VelocityCopyUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Padding="{StaticResource ContentGutterThickness}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource ContentGutterCompactThickness}" />
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightCompact}" />
                        <Setter Target="DropFlowContent.Width" Value="{StaticResource DropFlyoutWidthCompact}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="520" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource ContentGutterThickness}" />
                        <Setter Target="QueueList.MaxHeight" Value="{StaticResource QueueMaxHeightComfortable}" />
                        <Setter Target="DropFlowContent.Width" Value="{StaticResource DropFlyoutWidthComfortable}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="28">
            <TextBlock Text="VelocityCopy" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="CurrentItemText"
                   Grid.Row="1"
                   x:Uid="CurrentItemText"
                   Margin="0,8,0,4"
                   TextTrimming="CharacterEllipsis"
                   FontWeight="SemiBold" />

        <ProgressBar x:Name="GlobalProgress"
                     Grid.Row="2"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Height="{StaticResource ProgressBarHeight}" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SpeedText" Text="—" Opacity="0.75" />
            <TextBlock x:Name="EtaText" Grid.Column="1" Text="—" Opacity="0.75" />
        </Grid>

        <Grid x:Name="ActionStrip" Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" x:Uid="PauseButton" Click="OnPauseClick" IsEnabled="False" Margin="0,0,6,0" />
            <Button x:Name="SkipButton" x:Uid="SkipButton" Grid.Column="1" Click="OnSkipClick" IsEnabled="False" Margin="0,0,6,0" />
            <Button x:Name="StopButton" x:Uid="StopButton" Grid.Column="2" Click="OnStopClick" IsEnabled="False" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" x:Uid="CancelButton" Grid.Column="3" Click="OnCancelClick" IsEnabled="False" />
            <Button x:Name="QueueButton" x:Uid="QueueButton" Grid.Column="5" Click="OnQueueClick" IsEnabled="False" />
        </Grid>

        <Grid x:Name="QueuePanel"
              Grid.Row="5"
              Visibility="Collapsed"
              Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueTitle"
                           x:Uid="QueueTitle"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="QueueCountText"
                           Grid.Column="1"
                           Opacity="0.65" />
            </Grid>

            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      Margin="0,6,0,0"
                      MaxHeight="{StaticResource QueueMaxHeightCompact}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnQueueDragItemsCompleted"
                      HorizontalContentAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="QueueMoveUpButton"
                        x:Uid="QueueMoveUpButton"
                        Click="OnQueueMoveUpClick"
                        Margin="0,0,6,0" />
                <Button x:Name="QueueMoveDownButton"
                        x:Uid="QueueMoveDownButton"
                        Grid.Column="1"
                        Click="OnQueueMoveDownClick"
                        Margin="0,0,6,0" />
                <Button x:Name="QueueRemoveButton"
                        x:Uid="QueueRemoveButton"
                        Grid.Column="2"
                        Click="OnQueueRemoveClick" />
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.RowSpan="6"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 VerticalAlignment="Top"
                 Margin="0,32,0,0" />

        <Border x:Name="DragOverlay"
                Grid.RowSpan="6"
                Visibility="Collapsed"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.12"
                CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock x:Uid="DropOverlayText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Button x:Name="FlyoutAnchor" Visibility="Collapsed">
            <Button.Flyout>
                <Flyout x:Name="DropFlowFlyout" Placement="Bottom">
                    <Grid x:Name="DropFlowContent" Width="{StaticResource DropFlyoutWidthCompact}" MinHeight="176">
                        <Grid x:Name="DestinationStep">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="DestinationTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid x:Name="DestinationBrowserHeader"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DestinationBackButton"
                                        x:Uid="DestinationBackButton"
                                        Click="OnDestinationBackClick"
                                        Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DestinationPathText"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DestinationCapacityText"
                                               Opacity="0.65"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DestinationItems" Spacing="4" />
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowseButton"
                                        x:Uid="BrowseButton"
                                        Click="OnBrowseClick" />
                                <Button x:Name="ChooseCurrentFolderButton"
                                        x:Uid="ChooseCurrentFolderButton"
                                        Grid.Column="2"
                                        Visibility="Collapsed"
                                        Click="OnChooseCurrentFolderClick"
                                        Margin="0,0,6,0" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="LayoutStep" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="LayoutTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock x:Name="SelectedDestinationText" Grid.Row="1" TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,0,0,8" />

                            <StackPanel Grid.Row="2" Spacing="6">
                                <ToggleButton x:Name="PreserveToggle"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Click="OnPreserveClick">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Uid="PreserveTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreservePreview" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="DirectToggle"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Click="OnDirectClick">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Uid="DirectTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DirectPreview" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackButton" x:Uid="BackButton" Click="OnBackClick" />
                                <Button x:Name="StartCopyButton" x:Uid="StartCopyButton" Grid.Column="2" Click="OnQueueOrStartCopyClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Window>