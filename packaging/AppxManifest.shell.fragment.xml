<!--
  Fragment for the future sparse/MSIX package manifest.
  Keep CLSIDs synchronized with src/shell/explorer_commands.cpp.
-->
<Extensions
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5">

  <com:Extension Category="windows.comServer">
    <com:ComServer>
      <com:SurrogateServer AppId="8F50A7A5-8A93-4B0E-A444-D0E748630A3A" DisplayName="VelocityCopy Shell Commands">
        <com:Class
          Id="7E1D27A7-BA17-4EEA-9B93-967EE777BD21"
          Path="VelocityCopy.Shell.dll"
          ThreadingModel="STA" />
        <com:Class
          Id="CBBA1A7E-35B4-4708-9D03-9446D03FC843"
          Path="VelocityCopy.Shell.dll"
          ThreadingModel="STA" />
      </com:SurrogateServer>
    </com:ComServer>
  </com:Extension>

  <desktop4:Extension Category="windows.fileExplorerContextMenus">
    <desktop4:FileExplorerContextMenus>
      <desktop5:ItemType Type="*">
        <desktop5:Verb
          Id="VelocityCopy.Copy"
          Clsid="7E1D27A7-BA17-4EEA-9B93-967EE777BD21" />
      </desktop5:ItemType>

      <desktop5:ItemType Type="Directory">
        <desktop5:Verb
          Id="VelocityCopy.CopyDirectory"
          Clsid="7E1D27A7-BA17-4EEA-9B93-967EE777BD21" />
        <desktop5:Verb
          Id="VelocityCopy.PasteDirectory"
          Clsid="CBBA1A7E-35B4-4708-9D03-9446D03FC843" />
      </desktop5:ItemType>

      <!-- Directory\\Background is added after background-folder resolution is implemented and tested. -->
    </desktop4:FileExplorerContextMenus>
  </desktop4:Extension>
</Extensions>
